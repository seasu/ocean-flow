{"end": 114.3, "cuts": [["01", 0, 7.28], ["02", 7.28, 16.8], ["03", 16.8, 19.48], ["04a", 19.48, 24.07], ["04b", 24.07, 29.01], ["04c", 29.01, 35.76], ["05", 35.76, 42.84], ["06", 42.84, 50.4], ["07", 50.4, 65.32], ["08", 65.32, 73.56], ["09", 73.56, 82.76], ["10", 82.76, 95.32], ["11", 95.32, 103.76], ["12", 103.76, 114.3]], "subs": [[0, 6.88, "我們一直以為，世界只有眼睛看見的樣子"], [7.28, 16.4, "城市、山脈、海洋、人群，各自存在，彼此分離"], [16.8, 19.08, "直到有一天"], [19.48, 24.07, "有人在山中聽見不存在的鐘聲"], [24.07, 29.01, "有人在海邊看見逆光流動的痕跡"], [29.01, 35.36, "有人在夢裡，走進同一座從未見過的山門"], [35.76, 42.44, "我們開始明白，這個世界，從來不只一層"], [42.84, 50.0, "山有脈，海有流，人，亦有自己的道"], [50.4, 58.96, "那些被古人稱為氣、脈、道的存在，也許從未消失"], [58.96, 64.92, "只是人類，曾經失去感知它的能力"], [65.32, 73.16, "而現在，台灣，成為第一個重新啟流的地方"], [73.56, 82.36, "山脈甦醒，海流共鳴，城市之中，也出現靈界的回聲"], [82.76, 87.15, "有人開始修行，有人尋找宗門"], [87.15, 89.85, "有人踏上現世的路"], [89.85, 94.92, "只為了在靈界中，找到自己的機緣"], [95.32, 100.82, "這不是結束，而是一切的開始"], [100.82, 103.36, "這裡，是起源"]]}